# Copiar a .env.prod (NO commitear) y completar. Ningún valor de aquí debe ser el de ejemplo.
# Oracle de CAC: EZ Connect host:puerto/servicio (o descriptor completo si se usa SID).
ORACLE_DATA_SOURCE=servidor-oracle:1521/SERVICIO
# Usuario técnico del portal (dueño o con permisos sobre los objetos _pgpm).
ORACLE_USUARIO_TECNICO=CAMBIAR
ORACLE_PASSWORD_TECNICO=CAMBIAR
# Solo si el usuario técnico NO es el dueño del esquema _pgpm.
ORACLE_ESQUEMA=
# Dejar en 19: producción es 11.2.0.4 y el provider no tiene opción 11 (ver OracleSettings.cs).
ORACLE_VERSION_SQL=19
# Rol de Oracle que habilita la entrada al portal (lo crea 1_DBA_usuario_y_permisos.sql).
ORACLE_ROL_ACCESO=ROL_PORTAL_GERENCIAL
# false si el DBA prefiere correr él mismo el script de migraciones.
APLICAR_MIGRACIONES=true
# Production = SAP real por servicios web. Local = SAP simulado. Excel = exports (Sprint 0).
DATA_SOURCE_MODE=Production
# Servicios web de SAP: servidor y mandante de PRODUCCIÓN, usuario técnico solo para estos servicios.
# Producción (WSDL del ABAP, 08/10/2026). Desarrollo era vhazcdc3ci / mandante 320.
SAP_WS_URL=https://vhazcpc1ci.sap.cac.com:44300
SAP_WS_CLIENTE=100
SAP_WS_USUARIO=ZRFCCONN
SAP_WS_PASSWORD=CAMBIAR
SAP_WS_VALIDAR_CERTIFICADO=true
# Generar con:  openssl rand -base64 64
JWT_KEY=CAMBIAR_llave_aleatoria_de_64_bytes_base64
# Puertos publicados en el servidor (el 80/443 ya los usa Pago en Efectivo).
PUERTO_HTTP=8081
PUERTO_HTTPS=8443
# URL pública del portal (https, sin / final; con el puerto si no es 443)
PUBLIC_URL=https://portal-gerencial.cac.com.do:8443
# Usuarios de Oracle (separados por coma) que pueden cambiar parámetros en Sistema → Parámetros.
ADMIN_USUARIOS=KHENRIQUEZ
# false apaga el job diario de extracción/recálculo (p. ej. mientras el RFC no esté listo).
JOB_HABILITADO=true
# Alerta por correo si los datos pasan de MONITOREO.HORAS_ALERTA sin actualizarse (sección 11).
# Destinatarios separados por coma; vacío = la alerta solo queda registrada en el portal.
ALERTA_DESTINATARIOS=
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SSL=true
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=portal-gerencial@cac.com.do
