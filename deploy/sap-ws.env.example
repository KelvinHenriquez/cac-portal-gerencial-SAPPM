# Conexión a los servicios web de SAP (módulos Z_PM_MF_WS_*). Copiar a sprint0/sap_ws/sap.env (prueba
# en la laptop) o a .env.prod (servidor) y completar. NUNCA subir a git ni mandar por chat o correo.
SapWs__BaseUrl=https://vhazcdc3ci.sap.cac.com:44300
SapWs__Cliente=320
SapWs__Usuario=CAMBIAR
SapWs__Password=CAMBIAR
# Nombre del parámetro "fecha desde" de los módulos (confirmar en el WSDL).
SapWs__ParametroFechaDesde=IV_FECHA_DESDE
# false SOLO si el certificado del servidor SAP es de la CA interna de CAC y todavía no está instalado
# en el contenedor; en producción se instala la CA y se deja en true.
SapWs__ValidarCertificado=true
