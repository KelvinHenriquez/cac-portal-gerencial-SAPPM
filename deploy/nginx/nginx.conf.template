# Reverse proxy: HTTPS, /api -> API (.NET), todo lo demás -> frontend (Next.js).
# Certificado y llave se montan en /etc/nginx/certs (fullchain.pem y privkey.pem).
# Plantilla de la imagen oficial de nginx: ${PUERTO_HTTPS} se reemplaza al arrancar (solo las
# variables definidas en el contenedor; $host y demás quedan como variables de nginx).
server {
    listen 80;
    server_name _;
    return 301 https://$host:${PUERTO_HTTPS}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
