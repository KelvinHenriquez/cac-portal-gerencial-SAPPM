# Frontend producción (Next.js standalone).
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
# Red del servidor lenta o con cortes (ECONNRESET el 09/10/2026): más reintentos y paciencia.
RUN npm ci --no-audit --no-fund --fetch-retries=6 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=180000 --fetch-timeout=600000
COPY . .
# Vacío = llamadas relativas (/api/...) al mismo dominio; nginx enruta /api hacia la API.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
